NODE_ENV=production
API_BASIC_AUTH_USER=admin
API_BASIC_AUTH_PASSWORD=change-this-strong-password
APP_ENCRYPTION_KEY=replace-with-32-plus-char-random-key
DATABASE_URL=postgresql://clawbot:clawbot@db:5432/clawbot?schema=public
REDIS_URL=redis://redis:6379

WOO_BASE_URL=https://yourstore.com
WOO_CONSUMER_KEY=ck_xxx
WOO_CONSUMER_SECRET=cs_xxx

GMAIL_CLIENT_ID=your-google-client-id
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:3001/auth/gmail/callback
GMAIL_POLL_QUERY=(PayPal OR Zelle OR Cash App OR CashApp) subject:(payment OR sent OR received) newer_than:2d
