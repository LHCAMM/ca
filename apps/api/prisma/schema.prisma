generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  createdAt    DateTime @default(now())
}

model Order {
  id                    String    @id @default(cuid())
  wooOrderId            Int       @unique
  orderNumber           String
  status                String
  total                 Decimal   @db.Decimal(10,2)
  currency              String
  customerFirstName     String?
  customerLastName      String?
  customerEmail         String?
  itemsJson             Json?
  tagsJson              Json?
  wooRaw                Json?
  source                String    @default("poll")
  paymentConfirmed      Boolean   @default(false)
  paymentConfirmedAt    DateTime?
  orderMarkedProcessed  Boolean   @default(false)
  processedAt           DateTime?
  matchedPaymentId      String?
  createdAtWoo          DateTime
  lastSyncedAt          DateTime  @default(now())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  paymentEvents PaymentEvent[]
  followUps     FollowUpTask[]
  notes         OrderNote[]
}

model PaymentEvent {
  id              String   @id @default(cuid())
  provider        String
  providerRef     String?  @unique
  gmailMessageId  String?
  amount          Decimal  @db.Decimal(10,2)
  currency        String   @default("USD")
  payerEmail      String?
  payerName       String?
  detectedAt      DateTime
  confidence      Decimal  @db.Decimal(3,2) @default(0)
  matchMethod     String?
  rawSnippet      String?
  emailSubject    String?
  rawEmail        Json?
  matchedOrderId  String?
  matchedBy       String?
  decision        String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matchedOrder Order? @relation(fields: [matchedOrderId], references: [id])
}

model FollowUpTask {
  id              String   @id @default(cuid())
  orderId         String
  status          String   @default("scheduled")
  scheduledAt     DateTime
  sentAt          DateTime?
  attemptNumber   Int      @default(1)
  templateUsed    String   @default("default")
  draftContent    String   @db.Text
  gmailDraftId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

model SystemStatus {
  id            String   @id
  lastSuccessAt DateTime?
  lastError     String?
  healthy       Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model IntegrationSecret {
  id          String   @id
  encrypted   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  actor         String
  action        String
  resourceType  String?
  resourceId    String?
  beforeState   Json?
  afterState    Json?
  metadata      Json?
  createdAt     DateTime @default(now())
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  userId    String?
  note      String   @db.Text
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}
